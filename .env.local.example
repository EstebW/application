# ── kie.ai — clé pour l'analyse (Gemini 3 Flash) + Nano Banana 2 (génération photo) ───
# Obtenir sur : https://kie.ai/api-key
KIE_API_KEY=your_kie_api_key_here
# Secret Edge Function generate (Supabase Dashboard → Edge Functions → Secrets)
# Selfie (photo_edit) : nano-banana-2 + 1K par défaut — aligné sur les tests KIE rapides (~40s)
# PHOTO_EDIT_KIE_MODEL=nano-banana-2
# PHOTO_EDIT_KIE_RESOLUTION=1K
# A/B edit : PHOTO_EDIT_KIE_MODEL=google/nano-banana-edit
# Scènes inventées (full_generation) : 2K pour la qualité max
# KIE_RESOLUTION=2K

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://glgizfydsqsomrixgdyx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Clé service_role (Supabase Dashboard → Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Stripe ────────────────────────────────────────────────────────────────────
# Test: sk_test_ / pk_test_ / price_… test
# Live: sk_live_ / pk_live_ / price_… live  (hébergeur prod uniquement)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ONCE=price_...
STRIPE_PRICE_WEEKLY=price_...
STRIPE_PRICE_MONTHLY=price_...
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
# Prod: Dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# URL publique (success/cancel Checkout + Customer Portal return)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google OAuth (Supabase Auth) ───────────────────────────────────────────────
# 1) Google Cloud Console → Credentials → OAuth client (Web)
#    Authorized redirect URI :
#    https://<PROJECT_REF>.supabase.co/auth/v1/callback
# 2) Supabase → Authentication → Providers → Google → Client ID + Secret
# 3) Supabase → Authentication → URL Configuration → Redirect URLs :
#    http://localhost:3000/auth/callback
#    https://starfusion.online/auth/callback

# ── Tailles des célébrités (facultatif) ───────────────────────────────────────
# CELEBRITY_HEIGHT_LOOKUP_DISABLED=0
# CELEBRITY_HEIGHT_USER_AGENT=StarFusion/1.0 (https://ton-domaine.app; contact@ton-domaine.app)
